<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    
    <ImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/icon"
        android:contentDescription="B站侠应用图标" />

    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="B站侠"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#3F51B5" />

    
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="版本 1.8"
        android:textSize="14sp"
        android:textColor="#666666" />

    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="一个简单易用的本地音视频合并工具。\n基于 FFmpeg 构建。"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        android:textColor="#333333" />

   
    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="48dp"
        android:text="检查更新" />
        
        <Button
        android:id="@+id/btnToWeb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="48dp"
        android:text="去官网" />


    
    <TextView
        android:id="@+id/tvAuthor"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="Developed by MisakNetwork"
        android:textSize="13sp"
        android:textColor="#777777"
        android:contentDescription="开发者 MisakNetwork，点击访问 GitHub 主页"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Licensed under AGPL-3.0"
        android:textSize="12sp"
        android:textColor="#999999" />

</LinearLayout>